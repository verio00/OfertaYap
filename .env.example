# =============================================================================
# OfertaYap – Variables de entorno (plantilla)
# Copia este archivo como .env.local y completa los valores de tu proyecto
# Supabase de DESARROLLO. .env.local está ignorado por Git: nunca lo subas.
# =============================================================================

# Supabase → Project Settings → API (o "Connect") → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# o, en proyectos antiguos, la clave "anon" (legacy). Es pública por diseño.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la aplicación (sin "/" final). Se usa en el enlace de confirmación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional – solo para `npm run test:integration`: un buzón propio para
# probar el registro real (envía correos). Ejemplo: tu.correo+ofy01@gmail.com
INTEGRATION_TEST_EMAIL=

# NO definas aquí la clave service_role / secret key: HU01 no la necesita y
# nunca debe usarse con el prefijo NEXT_PUBLIC_.
